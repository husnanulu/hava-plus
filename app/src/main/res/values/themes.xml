<?xml version="1.0" encoding="utf-8"?>
<resources>

  <!--
    Uygulama penceresinin XML teması. Asıl renkler Compose tarafında
    (ui/theme/Theme.kt) tanımlanır; buradaki tema yalnızca pencere kabuğunu
    ayarlar: başlık çubuğu olmasın (NoActionBar).
  -->
  <style name="Theme.Hava" parent="android:Theme.Material.Light.NoActionBar" />

  <!--
    Açılış ekranı teması (core-splashscreen). Uygulama açılırken bu gösterilir:
    mavi (hava_sky) zemin + ortada "+°" logosu. installSplashScreen() çağrısından sonra
    pencere postSplashScreenTheme'e (Theme.Hava) geçer.
  -->
  <style name="Theme.Hava.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/hava_sky</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="postSplashScreenTheme">@style/Theme.Hava</item>
  </style>
</resources>
